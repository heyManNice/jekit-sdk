{
  "name": "jekit-sdk",
  "private": true,
  "version": "1.3",
  "scripts": {
    "dev": "npm run dev --workspace jekit-docs",
    "build:docs": "npm run build --workspace jekit-docs",
    "build:core": "npm run build --workspace jekit-core",
    "build:cdn": "npm run build --workspace jekit-cdn",
    "build:vue": "npm run build --workspace jekit-vue",
    "build:react": "npm run build --workspace jekit-react",
    "build:packages": "npm run build:core && npm run build:cdn && npm run build:vue && npm run build:react",
    "install:playwright": "npx playwright install --with-deps chromium",
    "docs": "npm run build:docs",
    "packages": "npm run build:packages",
    "all": "npm run packages && npm run docs"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "code-inspector-plugin": "^2.0.6",
    "vue": "^3.5.0"
  }
}