{
    "name": "jekit-docs",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite --port 5177 --host",
        "build": "npm run blog:indexes && npm run docs:indexes && vite build && npm run render",
        "preview": "serve dist -p 5177 -n",
        "render": "tsx tools/render.ts",
        "blog:indexes": "tsx tools/blog-indexes.ts",
        "docs:indexes": "tsx tools/docs-indexes.ts",
        "typecheck": "tsc -p tsconfig.typecheck.json",
        "start": "npm run build && npm run preview"
    },
    "devDependencies": {
        "@rolldown/plugin-babel": "^0.2.3",
        "@tailwindcss/vite": "^4.3.0",
        "@types/html-minifier-terser": "^7.0.2",
        "@types/node": "^25.9.1",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.2",
        "babel-plugin-react-compiler": "^1.0.0",
        "fast-glob": "^3.3.3",
        "html-minifier-terser": "^7.2.0",
        "marked": "^18.0.5",
        "playwright": "^1.60.0",
        "react-router": "^7.15.1",
        "rollup-plugin-visualizer": "^7.0.1",
        "serve": "^14.2.6",
        "shiki": "^4.3.0",
        "tailwindcss": "^4.3.0",
        "tsx": "^4.22.3",
        "typescript": "^6.0.3",
        "vite": "^8.0.14"
    },
    "dependencies": {
        "@lobehub/webfont-harmony-sans-sc": "^1.0.0",
        "chart.js": "^4.5.1",
        "framer-motion": "^12.40.0",
        "jekit-core": "*",
        "jekit-react": "*",
        "lucide-react": "^1.16.0",
        "react": "^19.2.6",
        "react-chartjs-2": "^5.3.1",
        "react-dom": "^19.2.6",
        "zustand": "^5.0.14"
    }
}
